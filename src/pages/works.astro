---
import Layout from '../layouts/Layout.astro';


const works = [
	{
		number: '01',
		title: '時雨録',
		category: 'Web',
		year: '2026',
		description:
			'Astroを使用して制作している個人ホームページ。ブログ、タイムライン、季節のエフェクトなどを実装しています。',
		link: '/'
	},

	{
		number: '02',
		title: '更新予定',
		category: '',
		year: '',
		description:
			'',
		link: ''
	},

	{
		number: '03',
		title: '更新予定',
		category: '',
		year: '',
		description:
			'',
		link: ''
	},

	{
		number: '04',
		title: '更新予定',
		category: '',
		year: '',
		description: '',
		link: ''
	}
];
---

<Layout title="Works">

	<!-- =========================
	     Header
	========================= -->

	<section class="works-header">

		<p class="page-label">
			WORKS
		</p>

		<h1>
			Works
		</h1>

		<p class="intro">
			これまでに制作したものと、
			学びの記録
		</p>

	</section>


	<!--  Works List -->

	<section class="works-list">

		{works.map((work) => (

			work.link ? (

				<a
					href={work.link}
					class="work-item"
				>

					<div class="work-number">
						{work.number}
					</div>


					<div class="work-main">

						<div class="work-meta">

							<span>
								{work.category}
							</span>

							<span>
								{work.year}
							</span>

						</div>


						<h2>
							{work.title}
						</h2>


						<p>
							{work.description}
						</p>

					</div>


					<span class="work-arrow">
						→
					</span>

				</a>

			) : (

				<div class="work-item no-link">

					<div class="work-number">
						{work.number}
					</div>


					<div class="work-main">

						<div class="work-meta">

							<span>
								{work.category}
							</span>

							<span>
								{work.year}
							</span>

						</div>


						<h2>
							{work.title}
						</h2>


						<p>
							{work.description}
						</p>

					</div>

				</div>

			)

		))}

	</section>

</Layout>


<style>

	.works-header {
		margin-bottom: 4rem;

		padding-bottom: 2rem;

		border-bottom:
			1px solid var(--border);
	}


	.page-label {
		margin:
			0 0 0.6rem;

		color: var(--orange);

		font-size: 0.7rem;

		letter-spacing: 0.3em;
	}


	.works-header h1 {
		margin:
			0 0 1rem;

		color: var(--text);

		font-size:
			clamp(
				2.5rem,
				6vw,
				4rem
			);

		font-weight: 500;

		letter-spacing: 0.12em;
	}


	.intro {
		max-width: 560px;

		margin: 0;

		color: var(--text-soft);

		font-size: 0.9rem;

		line-height: 2;
	}


	.works-list {
		display: flex;

		flex-direction: column;

		border-top:
			1px solid var(--border);
	}


	.work-item {
		display: grid;

		grid-template-columns:
			60px minmax(0, 1fr) 30px;

		align-items: center;

		gap: 1.5rem;

		position: relative;

		padding:
			2rem 0;

		color: inherit;

		text-decoration: none;

		border-bottom:
			1px solid var(--border);

		transition:
			padding-left 0.25s ease,
			border-color 0.25s ease;
	}


	a.work-item:hover {
		padding-left: 0.8rem;

		border-color:
			var(--orange);
	}


	a.work-item::before {
		content: "";

		position: absolute;

		top: 2rem;
		left: 0;

		width: 2px;
		height: 0;

		background:
			linear-gradient(
				to bottom,
				var(--ginkgo),
				var(--orange),
				var(--maple)
			);

		transition:
			height 0.25s ease;
	}


	a.work-item:hover::before {
		height:
			calc(100% - 4rem);
	}


	.work-number {
		align-self: start;

		padding-top: 0.2rem;

		color: var(--orange);

		font-family:
			"Shippori Mincho",
			serif;

		font-size: 0.72rem;

		letter-spacing: 0.12em;
	}


	.work-main {
		min-width: 0;
	}


	.work-meta {
		display: flex;

		flex-wrap: wrap;

		gap: 1rem;

		margin-bottom: 0.55rem;

		color: var(--text-muted);

		font-size: 0.72rem;

		letter-spacing: 0.08em;
	}


	.work-meta span:first-child {
		color: var(--ginkgo);
	}


	.work-main h2 {
		margin:
			0 0 0.7rem;

		color: var(--text);

		font-size: 1.4rem;

		font-weight: 500;

		transition:
			color 0.2s ease;
	}


	a.work-item:hover h2 {
		color: var(--gold);
	}


	.work-main p {
		max-width: 650px;

		margin: 0;

		color: var(--text-soft);

		font-size: 0.88rem;

		line-height: 1.9;
	}


	.work-arrow {
		color: var(--ginkgo);

		font-size: 1.1rem;

		transition:
			color 0.2s ease,
			transform 0.2s ease;
	}


	a.work-item:hover .work-arrow {
		color: var(--gold);

		transform:
			translateX(5px);
	}


	.no-link {
		grid-template-columns:
			60px minmax(0, 1fr);

		opacity: 0.85;
	}


	@media (max-width: 700px) {

		.works-header {
			margin-bottom: 3rem;
		}


		.works-header h1 {
			font-size: 2.5rem;
		}


		.work-item {
			grid-template-columns:
				35px minmax(0, 1fr) 20px;

			gap: 1rem;

			padding:
				1.5rem 0;
		}


		.no-link {
			grid-template-columns:
				35px minmax(0, 1fr);
		}


		a.work-item::before {
			top: 1.5rem;
		}


		a.work-item:hover::before {
			height:
				calc(100% - 3rem);
		}


		.work-main h2 {
			font-size: 1.2rem;
		}


		.work-main p {
			font-size: 0.84rem;
		}

	}

</style>