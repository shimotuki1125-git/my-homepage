---
import '../styles/global.css';
import AutumnEffect from '../components/AutumnEffect.astro';

const { title } = Astro.props;

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
	if (href === '/') {
		return pathname === '/';
	}

	return pathname.startsWith(href);
};
---

<html lang="ja">

	<head>
		<meta charset="utf-8" />

		<meta
			name="viewport"
			content="width=device-width"
		/>

		<title>{title}</title>

		<link
	rel="preconnect"
	href="https://fonts.googleapis.com"
/>

<link
	rel="preconnect"
	href="https://fonts.gstatic.com"
	crossorigin
/>

<link
	href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;700&display=swap"
	rel="stylesheet"
/>
	</head>


	<body>

		<AutumnEffect />


		<header>

	<a
		href="/"
		class="site-logo"
		aria-label="霜月 ホーム"
	>
		<img
			src="/images/shimotsuki-logo.png"
			alt="霜月"
		/>
	</a>


	<nav>
		<a
			href="/"
			class={isActive('/') ? 'active' : ''}
		>
			Home
		</a>

		<a
			href="/about"
			class={isActive('/about') ? 'active' : ''}
		>
			About
		</a>

		<a
			href="/works"
			class={isActive('/works') ? 'active' : ''}
		>
			Works
		</a>

		<a
			href="/blog"
			class={isActive('/blog') ? 'active' : ''}
		>
			Blog
		</a>
		<a
			href="/links"
			class={isActive('/links') ? 'active' : ''}
		>
			Links
		</a>
	</nav>

</header>


		<main>
			<slot />
		</main>


		<footer>
			@ 2026 SHIGUREROKU
		</footer>

	</body>

</html>