<div id="autumn-container"></div>

<script>
	const container =
		document.getElementById('autumn-container');


	/* 葉 */

	const leafImages: Record<string, string> = {
		fallen: '/images/leaves/fallen-leaf.webp',
		maple: '/images/leaves/maple.webp',
		ginkgo: '/images/leaves/ginkgo.webp'
	};

	Object.values(leafImages).forEach((src) => {
		const image = new Image();
		image.src = src;
	});


	/* 葉っぱの種類 */

	function getLeafType() {

		const random =
			Math.random();


		if (random < 0.5) {
			return 'fallen';
		}


		if (random < 0.7) {
			return 'maple';
		}


		return 'ginkgo';
	}

	function createLeaf(
		x: number,
		y: number
	) {

		if (!container) {
			return;
		}


		const type =
			getLeafType();


		const particle =
			document.createElement('div');


		particle.className =
			'autumn-particle';


		particle.style.left =
			`${x}px`;


		particle.style.top =
			`${y}px`;


		const leaf =
			document.createElement('img');


		leaf.src =
			leafImages[type];


		leaf.alt = '';


		leaf.className =
			`autumn-leaf ${type}`;


		particle.appendChild(leaf);

		container.appendChild(particle);


		/* サイズ */

		const size =
			Math.random() * 15 + 22;


		leaf.style.width =
			`${size}px`;


		const angle =
			Math.random()
			* Math.PI
			* 2;


		const distance =
			Math.random() * 50 + 55;


		const burstX =
			Math.cos(angle)
			* distance;


		const burstY =
			Math.sin(angle)
			* distance;


		const drift =
			Math.random() * 160 - 80;


		const finalX =
			burstX + drift;


		const finalY =
			window.innerHeight
			- y
			+ 100;


		const startRotation =
			Math.random() * 360;


		const endRotation =
			startRotation
			+ Math.random() * 100
			+ 80;


		const sway =
			Math.random() * 8 + 5;


		leaf.style.setProperty(
			'--rotation-start',
			`${startRotation}deg`
		);


		leaf.style.setProperty(
			'--rotation-end',
			`${endRotation}deg`
		);


		leaf.style.setProperty(
			'--sway',
			`${sway}px`
		);


		leaf.style.animationDuration =
			`${Math.random() * 0.8 + 1.3}s`;


		const burstAnimation =
			particle.animate(
				[
					{
						transform:
							'translate3d(0, 0, 0) scale(0.55)',

						opacity: 0
					},

					{
						transform:
							`translate3d(
								${burstX}px,
								${burstY}px,
								0
							) scale(1)`,

						opacity: 1
					}
				],

				{
					duration: 220,

					easing:
						'cubic-bezier(0.12, 0.8, 0.2, 1)',

					fill: 'forwards'
				}
			);


		burstAnimation.onfinish = () => {

			const fallDuration =
				Math.random() * 1500
				+ 4500;


			const fallAnimation =
				particle.animate(
					[
						{
							transform:
								`translate3d(
									${burstX}px,
									${burstY}px,
									0
								)`,

							opacity: 1
						},

						{
							transform:
								`translate3d(
									${burstX + drift * 0.35}px,
									${burstY + (finalY - burstY) * 0.33}px,
									0
								)`,

							opacity: 1,

							offset: 0.33
						},

						{
							transform:
								`translate3d(
									${burstX - drift * 0.15}px,
									${burstY + (finalY - burstY) * 0.66}px,
									0
								)`,

							opacity: 0.9,

							offset: 0.66
						},

						{
							transform:
								`translate3d(
									${finalX}px,
									${finalY}px,
									0
								)`,

							opacity: 0
						}
					],

					{
						duration:
							fallDuration,

						easing:
							'linear',

						fill:
							'forwards'
					}
				);


			fallAnimation.onfinish =
				() => {

					particle.remove();

				};

		};

	}


	function createBurst(
		x: number,
		y: number
	) {

		/*
		 * 8〜12枚
		 */
		const amount =
			Math.floor(
				Math.random() * 5
			) + 8;


		for (
			let i = 0;
			i < amount;
			i++
		) {

			setTimeout(
				() => {

					createLeaf(
						x,
						y
					);

				},

				Math.random() * 90
			);

		}

	}


	document.addEventListener(
		'pointerdown',
		(event) => {

			createBurst(
				event.clientX,
				event.clientY
			);

		}
	);
</script>


<style>

	#autumn-container {
		position: fixed;

		inset: 0;

		width: 100vw;
		height: 100vh;

		overflow: hidden;

		pointer-events: none;

		z-index: 9999;
	}


	:global(.autumn-particle) {
		position: absolute;

		width: 0;
		height: 0;

		pointer-events: none;

		will-change:
			transform,
			opacity;
	}


	:global(.autumn-leaf) {
		position: absolute;

		left: 0;
		top: 0;

		height: auto;

		transform:
			translate(-50%, -50%);

		transform-origin:
			center;

		pointer-events: none;

		user-select: none;

		filter:
			drop-shadow(
				0 3px 4px
				rgba(0, 0, 0, 0.3)
			);

		animation-name:
			leaf-sway;

		animation-timing-function:
			ease-in-out;

		animation-iteration-count:
			infinite;

		animation-direction:
			alternate;

		will-change:
			transform;
	}


	:global(.fallen) {
		filter:
			drop-shadow(
				0 3px 4px
				rgba(90, 50, 20, 0.3)
			);
	}


	/* もみじ */

	:global(.maple) {
		filter:
			drop-shadow(
				0 3px 5px
				rgba(170, 55, 35, 0.3)
			);
	}


	/* いちょう */

	:global(.ginkgo) {
		filter:
			drop-shadow(
				0 3px 5px
				rgba(190, 140, 35, 0.3)
			);
	}

	@keyframes leaf-sway {

		0% {
			transform:
				translate(
					calc(
						-50% - var(--sway)
					),
					-50%
				)
				rotate(
					var(--rotation-start)
				);
		}


		100% {
			transform:
				translate(
					calc(
						-50% + var(--sway)
					),
					-50%
				)
				rotate(
					var(--rotation-end)
				);
		}

	}

</style>