<div
	id="home-intro"
	class="home-intro hidden"
>
	<div id="intro-leaves"></div>

	<div class="intro-title">

		<p>
			SHIGUREROKU
		</p>

		<h1>
			時雨録
		</h1>

		<div class="intro-line"></div>

	</div>
</div>


<script>
	const intro =
		document.getElementById('home-intro');

	const leavesContainer =
		document.getElementById('intro-leaves');

	const hasSeenIntro =
		sessionStorage.getItem(
			'shigure-home-intro'
		);


	if (
		intro &&
		leavesContainer &&
		!hasSeenIntro
	) {

		/* 表示済みにする */

		sessionStorage.setItem(
			'shigure-home-intro',
			'true'
		);


		/* Intro表示 */

		intro.classList.remove(
			'hidden'
		);


		/* 葉っぱ画像　*/

		const leafImages = [
			'/images/leaves/fallen-leaf.webp',
			'/images/leaves/fallen-leaf.webp',
			'/images/leaves/fallen-leaf.webp',
			'/images/leaves/fallen-leaf.webp',
			'/images/leaves/fallen-leaf.webp',

			'/images/leaves/maple.webp',
			'/images/leaves/maple.webp',

			'/images/leaves/ginkgo.webp',
			'/images/leaves/ginkgo.webp',
			'/images/leaves/ginkgo.webp'
		];


		leafImages.forEach((src) => {

			const image =
				new Image();

			image.src =
				src;

		});


		/* 葉を生成 */

		for (
			let i = 0;
			i < 150;
			i++
		) {

			const leaf =
				document.createElement('img');


			/* 葉の種類 */

			leaf.src =
				leafImages[
					Math.floor(
						Math.random()
						* leafImages.length
					)
				];


			leaf.alt = '';

			leaf.className =
				'intro-leaf';


			const x =
				Math.random() * 100;


			const size =
				Math.random() * 26 + 18;


			const duration =
				Math.random() * 2.5 + 3.2;

			const delay =
				Math.random() * 0.65;


			const drift =
				Math.random() * 260 - 130;


			const rotation =
				Math.random() * 720 - 360;


			leaf.style.left =
				`${x}vw`;


			leaf.style.width =
				`${size}px`;


			leaf.style.animationDuration =
				`${duration}s`;


			leaf.style.animationDelay =
				`${delay}s`;


			leaf.style.setProperty(
				'--drift',
				`${drift}px`
			);


			leaf.style.setProperty(
				'--rotation',
				`${rotation}deg`
			);


			leavesContainer.appendChild(
				leaf
			);

		}


		setTimeout(() => {

			intro.classList.add(
				'fade-out'
			);

		}, 4300);


		setTimeout(() => {

			intro.remove();

		}, 5300);

	}
</script>


<style>


	.home-intro {
		position: fixed;

		inset: 0;

		width: 100vw;
		height: 100vh;

		z-index: 20000;

		overflow: hidden;

		background:
			radial-gradient(
				circle at center,
				#19150f 0%,
				#090806 65%
			);

		opacity: 1;

		transition:
			opacity 1s ease;
	}


	.home-intro.hidden {
		display: none;
	}


	.home-intro.fade-out {
		opacity: 0;

		pointer-events: none;
	}


	.intro-title {
		position: absolute;

		top: 50%;
		left: 50%;

		z-index: 2;

		text-align: center;

		transform:
			translate(
				-50%,
				-50%
			);

		animation:
			title-show
			1.5s
			ease
			forwards;
	}


	.intro-title p {
		margin:
			0 0 0.7rem;

		color:
			var(--ginkgo);

		font-size:
			0.7rem;

		letter-spacing:
			0.4em;
	}


	.intro-title h1 {
		margin: 0;

		color:
			var(--text);

		font-family:
			"Shippori Mincho",
			"Yu Mincho",
			serif;

		font-size:
			clamp(
				3rem,
				10vw,
				6rem
			);

		font-weight:
			500;

		letter-spacing:
			0.2em;

		text-shadow:
			0 0 25px
			rgba(
				217,
				164,
				65,
				0.15
			);
	}


	/* =========================
	   タイトル下のライン
	========================= */

	.intro-line {
		width: 0;
		height: 1px;

		margin:
			1.5rem auto 0;

		background:
			linear-gradient(
				90deg,
				var(--maple),
				var(--orange),
				var(--ginkgo)
			);

		animation:
			line-show
			1.3s
			0.7s
			ease
			forwards;
	}


	/* =========================
	   葉っぱレイヤー
	========================= */

	#intro-leaves {
		position: absolute;

		inset: 0;

		z-index: 3;

		pointer-events: none;
	}


	/* =========================
	   葉っぱ
	========================= */

	:global(.intro-leaf) {
		position: absolute;

		top: -100px;

		height: auto;

		opacity: 0;

		pointer-events: none;

		user-select: none;

		filter:
			drop-shadow(
				0 4px 5px
				rgba(
					0,
					0,
					0,
					0.3
				)
			);

		animation-name:
			intro-fall;

		/*
		 * 縦方向の速度を一定にする
		 * → 途中で葉が溜まりにくい
		 */
		animation-timing-function:
			linear;

		animation-fill-mode:
			forwards;

		will-change:
			transform,
			opacity;
	}


	/* =========================
	   葉っぱ落下
	========================= */

	@keyframes intro-fall {

		0% {
			transform:
				translate3d(
					0,
					-10vh,
					0
				)
				rotate(0deg);

			opacity: 0;
		}


		6% {
			opacity: 1;
		}


		25% {
			transform:
				translate3d(
					calc(
						var(--drift)
						* 0.35
					),
					22.5vh,
					0
				)
				rotate(
					calc(
						var(--rotation)
						* 0.25
					)
				);
		}


		50% {
			transform:
				translate3d(
					calc(
						var(--drift)
						* 0.65
					),
					55vh,
					0
				)
				rotate(
					calc(
						var(--rotation)
						* 0.5
					)
				);
		}


		75% {
			transform:
				translate3d(
					calc(
						var(--drift)
						* 0.85
					),
					87.5vh,
					0
				)
				rotate(
					calc(
						var(--rotation)
						* 0.75
					)
				);

			opacity: 0.9;
		}


		100% {
			transform:
				translate3d(
					var(--drift),
					120vh,
					0
				)
				rotate(
					var(--rotation)
				);

			opacity: 0;
		}

	}


	/* =========================
	   タイトル出現
	========================= */

	@keyframes title-show {

		0% {
			opacity: 0;

			transform:
				translate(
					-50%,
					calc(
						-50% + 15px
					)
				);
		}


		100% {
			opacity: 1;

			transform:
				translate(
					-50%,
					-50%
				);
		}

	}


	/* =========================
	   ライン出現
	========================= */

	@keyframes line-show {

		from {
			width: 0;
		}


		to {
			width: 150px;
		}

	}


	/* =========================
	   動きを減らす設定
	========================= */

	@media (
		prefers-reduced-motion:
		reduce
	) {

		:global(.intro-leaf) {
			display: none;
		}


		.intro-title {
			animation: none;
		}


		.intro-line {
			width: 150px;

			animation: none;
		}

	}

</style>